{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["model", "messages"],
  "additionalProperties": false,
  "properties": {
    "model": {"type": "string", "minLength": 1, "maxLength": 256, "allOf": [{"pattern": "\\S"}, {"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}]},
    "system": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S", "description": "Runtime also enforces 65536 UTF-8 bytes."},
    "messages": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "description": "Runtime additionally requires the last role to be user and limits the complete serialized request to 256 KiB.",
      "prefixItems": [{"allOf": [{"$ref": "#/$defs/message"}, {"properties": {"role": {"const": "user"}}}]}],
      "items": {"$ref": "#/$defs/message"}
    },
    "max_tokens": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 256},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 120000, "default": 30000},
    "base_url": {"type": "string", "minLength": 1, "default": "https://api.anthropic.com", "description": "Runtime validates an HTTPS origin, or HTTP literal loopback/localhost origin; no path except /, userinfo, query or fragment."},
    "secret_refs": {"type": "array", "const": ["ANTHROPIC_API_KEY"]}
  },
  "$defs": {
    "message": {
      "type": "object", "required": ["role", "content"], "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "enum": ["user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S", "description": "Runtime also enforces 65536 UTF-8 bytes."}
      }
    }
  }
}
