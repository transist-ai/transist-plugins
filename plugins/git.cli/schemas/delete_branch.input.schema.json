{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["force", "allow_missing"],
  "properties": {
    "output_mode": {"enum": ["legacy", "compact"], "default": "legacy"},
    "max_capture_bytes": {"type": "integer", "minimum": 1},
    "max_diagnostic_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "name": { "type": "string" },
    "default_name": { "type": "string" },
    "force": { "type": "boolean" },
    "allow_missing": { "type": "boolean" }
  },
  "anyOf": [
    { "required": ["name"] },
    { "required": ["default_name"] }
  ],
  "additionalProperties": false
}
