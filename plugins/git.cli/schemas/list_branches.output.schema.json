{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ok", "branches", "exit_code"],
  "allOf": [{"$ref": "compact.schema.json#/$defs/mode"}],
  "properties": {
    "output_mode": {"const": "compact"},
    "diagnostics": {"$ref": "compact.schema.json#/$defs/diagnostics"},
    "ok": { "type": "boolean" },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "current", "remote"],
        "properties": {
          "name": { "type": "string" },
          "current": { "type": "boolean" },
          "remote": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "exit_code": { "type": "integer" }
  },
  "additionalProperties": false
}
