{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["output_file"],
  "properties": {
    "output_file": {"type": "string", "minLength": 1},
    "scope": {"enum": ["tracked", "changed"], "default": "tracked"},
    "base_ref": {"type": "string", "minLength": 1, "pattern": "^refs/"},
    "pr_file": {"type": "string", "minLength": 1},
    "remote": {"type": "string", "minLength": 1},
    "output_mode": {"enum": ["legacy", "compact"], "default": "legacy"},
    "max_diagnostic_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"scope": {"const": "changed"}}, "required": ["scope"]},
     "then": {"oneOf": [
       {"required": ["base_ref"], "not": {"anyOf": [{"required": ["pr_file"]}, {"required": ["remote"]}]}},
       {"required": ["pr_file", "remote"], "not": {"required": ["base_ref"]}}
     ]},
     "else": {"not": {"anyOf": [{"required": ["base_ref"]}, {"required": ["pr_file"]}, {"required": ["remote"]}]}}
    }
  ]
}
