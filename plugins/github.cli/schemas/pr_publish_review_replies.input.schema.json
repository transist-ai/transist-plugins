{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["response_plan_file"],
  "properties": {
    "output_mode": {"enum": ["legacy", "compact"], "default": "legacy"},
    "max_response_bytes": {"type": "integer", "minimum": 1, "default": 5242880},
    "max_total_response_bytes": {"type": "integer", "minimum": 1, "default": 20971520},
    "max_plan_bytes": {"type": "integer", "minimum": 1, "default": 5242880},
    "max_replies": {"type": "integer", "minimum": 1, "default": 1000},
    "max_diagnostic_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "repo": { "type": "string" },
    "pull_request": { "type": "string" },
    "response_plan_file": { "type": "string", "minLength": 1, "description": "Bounded regular UTF-8 response plan; supports staged absolute document reads." },
    "state_file": { "type": "string", "description": "Deduplication JSON data, including a staged document write or update path; never selects the repository." },
    "output_file": { "type": "string", "description": "Optional result JSON data destination, including a staged absolute document path." },
    "resolve_addressed_threads": { "type": ["boolean", "string"] }
  },
  "additionalProperties": false
}
