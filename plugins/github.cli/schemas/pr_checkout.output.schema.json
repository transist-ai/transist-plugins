{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ok", "pull_request", "exit_code"],
  "allOf": [{"$ref": "compact.schema.json#/$defs/mode"}],
  "properties": {
    "output_mode": {"const": "compact"},
    "diagnostics": {"$ref": "compact.schema.json#/$defs/diagnostics"},
    "ok": { "type": "boolean" },
    "pull_request": { "type": "string" },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "exit_code": { "type": "integer" }
  },
  "additionalProperties": false
}
