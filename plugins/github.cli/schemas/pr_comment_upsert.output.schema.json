{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ok",
    "operation",
    "created",
    "updated",
    "unchanged",
    "comment_id",
    "comment_url",
    "marker",
    "exit_code"
  ],
  "properties": {
    "output_mode": {"const": "compact"},
    "diagnostics": {"$ref": "compact.schema.json#/$defs/diagnostics"},
    "ok": { "type": "boolean" },
    "operation": { "type": "string", "enum": ["created", "updated", "unchanged"] },
    "created": { "type": "boolean" },
    "updated": { "type": "boolean" },
    "unchanged": { "type": "boolean" },
    "comment_id": { "type": "string" },
    "comment_url": { "type": "string" },
    "marker": { "type": "string" },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "exit_code": { "type": "integer" }
  },
  "allOf": [{"$ref": "compact.schema.json#/$defs/mode"}],
  "additionalProperties": false
}
