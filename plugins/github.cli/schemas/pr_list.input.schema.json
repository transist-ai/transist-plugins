{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "output_mode": {"enum": ["legacy", "compact"], "default": "legacy"},
    "max_response_bytes": {"type": "integer", "minimum": 1, "default": 5242880},
    "max_total_response_bytes": {"type": "integer", "minimum": 1, "default": 20971520},
    "max_diagnostic_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "repo": { "type": "string" },
    "state": { "type": "string", "enum": ["open", "closed", "merged", "all"] },
    "base": { "type": "string" },
    "head": { "type": "string" },
    "limit": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
