{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["model"],
  "oneOf": [{"required": ["prompt"], "not": {"required": ["prompt_file"]}}, {"required": ["prompt_file"], "not": {"required": ["prompt"]}}],
  "properties": {
    "output_mode": { "type": "string", "enum": ["legacy", "compact"], "default": "legacy" },
    "max_prompt_bytes": { "type": "integer", "minimum": 1 },
    "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
    "prompt": { "type": "string", "minLength": 1 },
    "prompt_file": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "timeout_seconds": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
