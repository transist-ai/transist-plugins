{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transist.dev/schemas/app/invoke.request.v1.schema.json",
  "title": "APP Invoke Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "invoke_id",
    "run_id",
    "workflow_id",
    "step",
    "plugin",
    "action",
    "input",
    "paths",
    "requested_capabilities",
    "policy",
    "metadata"
  ],
  "properties": {
    "type": {
      "const": "app.invoke.request.v1"
    },
    "protocol_version": {
      "type": "string",
      "const": "app.v1"
    },
    "invoke_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "$ref": "#/$defs/step"
    },
    "plugin": {
      "$ref": "#/$defs/pluginIdentity"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "description": "Arbitrary JSON payload materialized by the runtime for the selected action."
    },
    "paths": {
      "$ref": "#/$defs/paths"
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityRequest"
      }
    },
    "policy": {
      "description": "Additive host policy metadata forwarded from the TEP invoke request."
    },
    "timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "metadata": {
      "description": "Host-provided metadata reserved for runtime bookkeeping."
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "execution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pluginIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_root",
        "artifacts_dir",
        "evidence_dir",
        "workspace_dir"
      ],
      "properties": {
        "run_root": {
          "type": "string",
          "description": "Invocation-private staging root; never durable run storage.",
          "minLength": 1
        },
        "artifacts_dir": {
          "type": "string",
          "minLength": 1
        },
        "evidence_dir": {
          "type": "string",
          "minLength": 1
        },
        "workspace_dir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "resource",
        "operations"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "enum": [
            "adapter",
            "plugin",
            "action",
            "provider",
            "secret",
            "filesystem",
            "network",
            "approval"
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
