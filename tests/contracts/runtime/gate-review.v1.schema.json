{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transist.dev/schemas/runtime/gate-review.v1.schema.json",
  "title": "Immutable manual gate review request and decision v1",
  "$ref": "#/$defs/decision",
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "run_id", "gate_id", "step_id", "execution", "review_documents"],
      "properties": {
        "schema": { "const": "transist.gate_review_request.v1" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "gate_id": { "$ref": "#/$defs/identifier" },
        "step_id": { "$ref": "#/$defs/identifier" },
        "execution": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "review_documents": { "type": "array", "minItems": 1, "items": { "$ref": "managed-documents.v1.schema.json#/$defs/revision" } }
      }
    },
    "decision": {
      "description": "Document gates require review_request exactly equal to the runtime's committed waiting request. Non-document gates omit it. Contextual identity equality is enforced by the kernel.",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "run_id", "gate_id", "step_id", "decision"],
      "properties": {
        "schema": { "const": "transist.gate_decision.v1" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "gate_id": { "$ref": "#/$defs/identifier" },
        "step_id": { "$ref": "#/$defs/identifier" },
        "decision": { "enum": ["approved", "rejected", "request_changes"] },
        "actor": { "type": "string" }, "actor_source": { "type": "string" }, "reason": { "type": "string" },
        "decided_at_ms": { "type": "integer", "minimum": 0 },
        "review_request": { "$ref": "#/$defs/request" }
      }
    }
  }
}
